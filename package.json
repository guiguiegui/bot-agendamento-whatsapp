{
  "name": "whatsapp-bot-agendamento",
  "version": "1.0.0",
  "description": "Bot de agendamento via WhatsApp para pequenos negócios (barbearias, salões, clínicas) — fila assíncrona com BullMQ/Redis, máquina de estados testável e persistência com SQLite.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx scripts/smoke-e2e.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.12.12",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
