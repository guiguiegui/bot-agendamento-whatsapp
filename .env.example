# Copie este arquivo para ".env" e ajuste os valores.

# Onde o arquivo do banco SQLite é criado/lido.
DATABASE_PATH=./data/bot.db

# Conexão com o Redis usado pela fila (BullMQ) e pelo estado da conversa.
REDIS_URL=redis://localhost:6379

# Pasta onde a Baileys guarda as credenciais da sessão do WhatsApp
# (gerada automaticamente no primeiro QR code escaneado).
WHATSAPP_AUTH_DIR=./data/auth

# Números autorizados a usar comandos administrativos (ex: /hoje), separados
# por vírgula, formato internacional só com dígitos: DDI+DDD+número.
ADMIN_PHONE_NUMBERS=5519991234567

# debug | info | warn | error
LOG_LEVEL=info
